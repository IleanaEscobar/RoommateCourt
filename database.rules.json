{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "name": {
          ".read": "auth != null"
        }
      }
    },
    "households": {
      "$householdId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || !data.exists() || newData.child('members').child(auth.uid).exists())"
      }
    },
    "cases": {
      "$caseId": {
        ".read": "auth != null && (data.child('users').child(auth.uid).exists() || !data.exists())",
        ".write": "auth != null && (data.child('users').child(auth.uid).exists() || !data.exists())"
      }
    },
    "caseSubmissions": {
      "$caseId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "casePresence": {
      "$caseId": {
        ".read": "auth != null && (root.child('cases').child($caseId).child('users').child(auth.uid).exists() || root.child('households').child(root.child('cases').child($caseId).child('householdId').val()).child('members').child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (root.child('cases').child($caseId).child('users').child(auth.uid).exists() || root.child('households').child(root.child('cases').child($caseId).child('householdId').val()).child('members').child(auth.uid).exists())",
          ".validate": "newData.val() === true"
        }
      }
    },
    "caseVotes": {
      "$caseId": {
        ".read": "auth != null && (root.child('cases').child($caseId).child('users').child(auth.uid).exists() || root.child('households').child(root.child('cases').child($caseId).child('householdId').val()).child('members').child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (root.child('cases').child($caseId).child('users').child(auth.uid).exists() || root.child('households').child(root.child('cases').child($caseId).child('householdId').val()).child('members').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['verdict', 'name', 'createdAt']) && newData.child('verdict').isString() && newData.child('name').isString()"
        }
      }
    },
    "householdCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
